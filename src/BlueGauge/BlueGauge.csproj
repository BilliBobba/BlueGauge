<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\BlueGauge.ico</ApplicationIcon>
    <AssemblyTitle>BlueGauge</AssemblyTitle>
    <Description>Bluetooth and USB battery dashboard for Windows</Description>
    <Version>1.1.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
