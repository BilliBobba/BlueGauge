<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <StartupObject>BlueGauge.Program</StartupObject>
    <AssemblyName>BlueGauge</AssemblyName>
    <RootNamespace>BlueGauge</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>none</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\BlueGauge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Runtime.Serialization" /><Reference Include="System.Xml" />
    <Reference Include="System.Runtime.WindowsRuntime" />
    <Reference Include="Windows">
      <HintPath>$(WindowsWinMd)</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <Target Name="CheckWinMd" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(WindowsWinMd)')" Text="Windows.winmd not found. Run scripts/build.ps1 or set WindowsWinMd to the Windows SDK UnionMetadata file." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
